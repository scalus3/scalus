{
  "name": "scalus",
  "version": "1.1.1",
  "description": "Scalus – Cardano on-chain / off-chain toolkit compiled with Scala.js",
  "type": "module",
  "files": [
    "scalus.js",
    "scalus.d.ts",
    "README.md"
  ],
  "keywords": [
    "cardano",
    "plutus",
    "script",
    "evaluator",
    "scala",
    "scalajs"
  ],
  "main": "scalus.js",
  "module": "scalus.js",
  "types": "scalus.d.ts",
  "exports": {
    ".": {
      "types": "./scalus.d.ts",
      "import": "./scalus.js",
      "default": "./scalus.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run typecheck && npm run typecheck:providers && vitest run",
    "typecheck": "tsc --noEmit --strict --target es2020 --moduleResolution bundler --module esnext scalus.d.ts __tests__/scalus-dts.consumer.ts",
    "typecheck:providers": "tsc --noEmit --strict --skipLibCheck --target es2020 --moduleResolution bundler --module esnext scalus.d.ts __tests__/provider-mesh.test.ts __tests__/provider-lucid.test.ts __tests__/collision.test.ts __tests__/object-api-guards.test.ts",
    "test:watch": "vitest",
    "build:browser-tests": "esbuild __tests__/shared-tests.ts --bundle --outfile=shared-tests-bundle.js --format=iife --global-name=SharedTests"
  },
  "devDependencies": {
    "@lucid-evolution/lucid": "^0.6.2",
    "@lucid-evolution/uplc": "^0.2.22",
    "@meshsdk/core": "^1.9.0-beta.98",
    "@types/node": "^22.0.0",
    "cbor-x": "^1.6.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scalus3/scalus.git"
  },
  "homepage": "https://scalus.org",
  "license": "Apache-2.0"
}
