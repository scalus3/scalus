#!/usr/bin/env bash
#
# eject-examples — create standalone sbt projects from Scalus examples.
#
# Usage:
#   ./eject-examples --all <target-dir>
#   ./eject-examples --only <name> [<name> ...] <target-dir>
#   ./eject-examples --list
#
# Each ejected project is a self-contained sbt build that depends on published
# Scalus artifacts, configures the Scalus compiler plugin, and enables
# ScalusSbtPlugin (so `sbt blueprint` and `sbt deploy` work out of the box).

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
EXAMPLES_ROOT="$SCRIPT_DIR/scalus-examples/jvm/src/main/scala/scalus/examples"
TESTS_ROOT="$SCRIPT_DIR/scalus-examples/jvm/src/test/scala/scalus/examples"

# The latest release, as the monorepo's build.sbt names it (`scalusStableVersion`);
# the pinned value is for a checkout whose build.sbt does not say it.
SCALUS_VERSION="$(sed -n 's/^val scalusStableVersion = "\(.*\)"$/\1/p' "$SCRIPT_DIR/build.sbt" 2>/dev/null)"
SCALUS_VERSION="${SCALUS_VERSION:-1.5.0}"

# Ejected projects target sbt 2.0.0 (where `test` is cached and `testFull` runs
# uncached, like sbt 1.x `test`). Pinned independently of the monorepo, which
# still builds on sbt 1.x — so we must NOT read it from project/build.properties.
SBT_VERSION="2.0.0"
SCALA_VERSION="3.3.9"

EXCLUDED_EXAMPLES="cape setbench buidlerfest linkedlist bilinearAccumulator platform"

# Examples that need sources from other examples bundled in.
# Format: "example:dep1,dep2"
BUNDLED_DEPS="storage:linkedlist"

# Tests that check what only the monorepo has, and are not ejected: the vesting
# example's Lean workspace shares the packages of Scalus's own Lean library, and
# the USDCx statements are checked in a Lean workspace of their own there.
SKIPPED_TESTS="VestingVerificationSupportTest.scala UsdcxMintingPolicyVerificationTest.scala"

usage() {
    cat <<EOF
Usage:
  $(basename "$0") [--scalus-version V] --all <target-dir>
  $(basename "$0") [--scalus-version V] --only <name> [<name> ...] <target-dir>
  $(basename "$0") --list

Options:
  --scalus-version Override the Scalus version pinned in the generated project.
                   Default: \`val scalusStableVersion\` from build.sbt.
                   Use a locally-published SNAPSHOT (e.g. from \`sbtn publishLocal\`)
                   when the target version isn't on Maven Central yet.
  --all            Eject every directory-based example.
  --only NAMES...  Eject only the named examples (last arg is target dir).
  --list           Print all available examples and exit.

Each example becomes <target-dir>/<kebab-name>/scalus/ with its own build.sbt,
project/, sources, tests, and README.
EOF
}

list_examples() {
    find "$EXAMPLES_ROOT" -mindepth 1 -maxdepth 1 -type d \
        -exec basename {} \; | sort | while IFS= read -r name; do
        case " $EXCLUDED_EXAMPLES " in
            *" $name "*) ;;
            *) echo "$name" ;;
        esac
    done
}

# Maps source directory names to kebab-case output names
# (matching the Cardano Foundation convention).
kebab_name() {
    local name="$1"
    case "$name" in
        amm)                    echo "constant-product-amm" ;;
        anonymousdata)          echo "anonymous-data" ;;
        atomictransactions)     echo "atomic-transaction" ;;
        crowdfunding)           echo "crowdfund" ;;
        decentralizedidentity)  echo "decentralized-identity" ;;
        editablenft)            echo "editable-nft" ;;
        paymentsplitter)        echo "payment-splitter" ;;
        simpletransfer)         echo "simple-transfer" ;;
        simplewallet)           echo "simple-wallet" ;;
        upgradeableproxy)       echo "upgradable-proxy" ;;
        *)                      echo "$name" ;;
    esac
}

# ---- generators -------------------------------------------------------------

detect_extra_deps() {
    local src_dir="$1"
    local test_dir="$2"
    local extras=()
    local scan_dirs=("$src_dir")
    if [[ -d "$test_dir" ]]; then
        scan_dirs+=("$test_dir")
    fi
    for d in "${scan_dirs[@]}"; do
        if grep -rqE '^[[:space:]]*import[[:space:]]+scalus\.bloxbean' "$d" 2>/dev/null; then
            extras+=( '"org.scalus" %% "scalus-bloxbean-cardano-client-lib" % scalusVersion' )
            break
        fi
    done
    for d in "${scan_dirs[@]}"; do
        if grep -rqE '^[[:space:]]*import[[:space:]]+scalus\.patterns' "$d" 2>/dev/null; then
            extras+=( '"org.scalus" %% "scalus-design-patterns" % scalusVersion' )
            break
        fi
    done
    if uses_verification "$test_dir"; then
        extras+=( '"org.scalus" %% "scalus-verification" % scalusVersion % Test' )
        extras+=( '"org.scalus" %% "scalus-verification-scalatest" % scalusVersion % Test' )
    fi
    if (( ${#extras[@]} )); then
        printf '%s\n' "${extras[@]}"
    fi
}

# Whether the example's tests state proofs (scalus-verification).
uses_verification() {
    local test_dir="$1"
    [[ -d "$test_dir" ]] &&
        grep -rqE '^[[:space:]]*import[[:space:]]+scalus\.verify' "$test_dir" 2>/dev/null
}

gen_snapshot_resolver() {
    if [[ "$SCALUS_VERSION" == *SNAPSHOT* ]]; then
        cat <<'BLOCK'
// TODO: switch to a released version and remove this resolver
resolvers += "Sonatype Central Snapshots" at "https://central.sonatype.com/repository/maven-snapshots/"
BLOCK
    fi
}

gen_build_sbt() {
    local name="$1" src_dir="$2" test_dir="$3"
    local extras
    extras="$(detect_extra_deps "$src_dir" "$test_dir")"
    local extra_lines=""
    if [[ -n "$extras" ]]; then
        while IFS= read -r dep; do
            extra_lines+=",
            $dep"
        done <<< "$extras"
    fi
    # Suites of proofs: the statements Lean does not finish wait for their time limit,
    # so `test` leaves them out (`sbt verify` does as well); `testOnly` runs them.
    local verification_lines=""
    if uses_verification "$test_dir"; then
        verification_lines="
        Test / testOptions += Tests.Argument(
          TestFrameworks.ScalaTest, \"-l\", \"scalus.verify.uplcblaster.Unfinished\"
        ),"
    fi
    cat <<EOF
ThisBuild / scalaVersion := "$SCALA_VERSION"
ThisBuild / organization := "org.scalus.examples"
ThisBuild / version      := "0.1.0-SNAPSHOT"

$(gen_snapshot_resolver)
val scalusVersion = "$SCALUS_VERSION"

lazy val root = (project in file("."))
    .enablePlugins(ScalusSbtPlugin)
    .settings(
        name := "$name",
        scalacOptions ++= Seq("-deprecation", "-feature"),
        libraryDependencies ++= Seq(
            "org.scalus" %% "scalus"                % scalusVersion,
            "org.scalus" %% "scalus-cardano-ledger" % scalusVersion,
            "org.scalus" %% "scalus-testkit"         % scalusVersion % Test,
            "org.scalatest" %% "scalatest"           % "3.2.20"     % Test$extra_lines
        ),
        addCompilerPlugin(
            ("org.scalus" %% "scalus-plugin" % scalusVersion).cross(CrossVersion.full)
        ),$verification_lines
        Compile / sources := {
            val base = baseDirectory.value
            val testDir = base / "test"
            val targetDir = target.value
            (base ** "*.scala").get()
                .filterNot(f => f.relativeTo(testDir).isDefined)
                .filterNot(f => f.relativeTo(targetDir).isDefined)
                .toSeq
        },
        Test / sources := ((baseDirectory.value / "test") ** "*.scala")
            .get()
            .toSeq,
    )
EOF
}

gen_plugins_sbt() {
    cat <<EOF
$(gen_snapshot_resolver)
addSbtPlugin("org.scalus" % "scalus-sbt-plugin" % "$SCALUS_VERSION")
EOF
}

gen_build_properties() {
    cat <<EOF
sbt.version=$SBT_VERSION
EOF
}

gen_gitignore() {
    cat <<'EOF'
target/
project/target/
project/project/
.bsp/
.bloop/
.metals/
.idea/
.vscode/
EOF
}

gen_verification_section() {
    local has_verification="$1"
    if [[ "$has_verification" != "yes" ]]; then
        return
    fi
    cat <<'EOF'

## Formal verification

The `*VerificationTest` suites prove properties of the compiled validator with
Lean 4, Blaster and Z3 (see https://scalus.org/docs/verification). They need
[elan](https://github.com/leanprover/elan) and Z3 5.4.0 or later on the `PATH`.

```sh
sbt verify
```

`verify` builds the project's Lean workspace, `src/test/lean/<Project>`, and runs
the suites with Lean required. The first run clones and builds Blaster and
PlutusCore, which takes several minutes. The workspace is created automatically
where it is missing; whether to commit it is up to you.

The results of the proofs are kept beside each suite, in `test/*.proofs.json`.
Without Lean, `sbt test` takes a kept result that still agrees with the code, and
cancels the test of one that does not. The kept results come from the Scalus
monorepo, where the checks ran in another workspace, so the first `sbt verify`
proves every statement again and rewrites them.

The tests tagged `Unfinished` are statements Lean does not finish; `test` and
`verify` leave them out, and `testOnly` runs them:

```sh
sbt "testOnly *VerificationTest -- -n scalus.verify.uplcblaster.Unfinished"
```
EOF
}

gen_getting_started() {
    local name="$1" has_verification="${2:-no}"
    cat <<EOF
# Getting Started

Standalone Scalus example, also available in the [scalus3/scalus](https://github.com/scalus3/scalus) monorepo.
Set up your Scala 3 Development environment: https://scalus.org/docs/get-started#install-scala-3-development-environment 

## Build

Compile the on-chain and off-chain sources:
	
\`\`\`sh
sbt compile
\`\`\`

## Test

Run all tests (unit + integration; uses the emulator backend).

\`\`\`sh
sbt test
\`\`\`

Test backends:

\`\`\`sh
sbt test                           # in-memory emulator (the default)
SCALUS_TEST_ENV=emulator sbt test  # in-memory emulator, named explicitly
SCALUS_TEST_ENV=yaci sbt test      # a local Yaci DevKit node (auto-started; requires Docker)
\`\`\`

## Profiling

Run the tests with on-chain execution profiling enabled. It writes an interactive HTML report (CPU and memory budget per source line) to target/profile.html

\`\`\`sh
SCALUS_PROFILE=1 sbt test
\`\`\`

## CIP-57 blueprints

\`sbt package\` embeds a CIP-57 blueprint JSON for every Contract in the JAR at
\`META-INF/scalus/blueprints/<Contract>.json\`. Run \`sbt blueprint\` to generate
without packaging — output goes to
\`target/scala-$SCALA_VERSION/resource_managed/main/META-INF/scalus/blueprints/<Contract>.json\`.
Skip generation during \`package\` with \`blueprint / skip := true\` or \`SCALUS_SKIP_BLUEPRINT=1\`.

## Deploy as a reference script

Requires a Blockfrost project id and a funded wallet mnemonic on the chosen network.

\`\`\`sh
sbt "deploy <ContractName> --network preview \\
    --blockfrost-key <project-id> \\
    --mnemonic '<24 words>'"
\`\`\`

Or via environment variables:

\`\`\`sh
export CARDANO_NETWORK=preview
export BLOCKFROST_API_KEY=<project-id>
export CARDANO_MNEMONIC='<24 words>'
sbt "deploy <ContractName>"
\`\`\`

The contract is deployed as a reference script UTxO at the sender's own base
address; the transaction hash is printed on success.
$(gen_verification_section "$has_verification")
## Pinned versions

- Scalus: \`$SCALUS_VERSION\`
- Scala:  \`$SCALA_VERSION\`
- sbt:    \`$SBT_VERSION\`
EOF
}

# Portable in-place sed: plain POSIX sed + temp file. Avoids the `-i` flavor
# difference (BSD/macOS needs a backup-suffix arg, GNU must not have one), so no
# perl dependency and no flag detection — works on BSD, GNU, busybox alike.
sed_i() {
    local script="$1"; shift
    local f tmp
    for f in "$@"; do
        tmp="$(mktemp "${TMPDIR:-/tmp}/eject.XXXXXX")"
        sed "$script" "$f" > "$tmp" && mv "$tmp" "$f"
    done
}

# Rewrites package declarations: scalus.examples.X -> X
rewrite_packages() {
    local dir="$1"
    while IFS= read -r -d '' f; do
        # Strip the scalus.examples. prefix everywhere — package/import lines AND
        # inline fully-qualified references (e.g. d.to[scalus.examples.pricebet.OracleState]).
        sed_i 's/scalus\.examples\.//g' "$f"
    done < <(find "$dir" -name '*.scala' -print0)
}

# Points the suites of proofs at the ejected project's layout. In the monorepo a
# suite names its kept results by their place there,
#   LeanProofs.inSources("scalus-examples", ..., "scala", "scalus", "examples", "<name>"),
# and they are in test/ here. The vesting suite runs its checks in the monorepo's
# LinearVesting workspace; here it takes the project's own, which the sbt plugin
# names and the first suite creates.
rewrite_verification_paths() {
    local dir="$1"
    # A call spans several lines, one argument on each, so the file is read whole into
    # the pattern space (`:a`, `N`, `$!ba`); one command on each line of the script is
    # how BSD and GNU sed both take the label.
    local kept=':a
N
$!ba
s/inSources([^)]*"examples",[^)]*)/inSources("test")/g'
    local workspace='s/LeanProofs\.inSources("scalus-examples", "jvm", "src", "test", "lean", "LinearVesting")/LeanProofs.projectWorkspace/g'
    while IFS= read -r -d '' f; do
        sed_i "$kept" "$f"
        sed_i "$workspace" "$f"
    done < <(find "$dir" -name '*.scala' -print0)
}

# Returns bundled dependency names for an example, if any.
get_bundled_deps() {
    local name="$1"
    for entry in $BUNDLED_DEPS; do
        local key="${entry%%:*}"
        local deps="${entry#*:}"
        if [[ "$key" == "$name" ]]; then
            echo "$deps" | tr ',' ' '
            return
        fi
    done
}

# ---- core -------------------------------------------------------------------

eject_one() {
    local name="$1" target_root="$2"
    local src_dir="$EXAMPLES_ROOT/$name"
    local test_dir="$TESTS_ROOT/$name"
    if [[ ! -d "$src_dir" ]]; then
        echo "error: example '$name' not found at $src_dir" >&2
        return 1
    fi

    local out_name
    out_name="$(kebab_name "$name")"
    local project_dir="$target_root/$out_name"
    if [[ -e "$project_dir" ]]; then
        echo "error: $project_dir already exists, refusing to overwrite" >&2
        return 1
    fi

    mkdir -p "$project_dir/project"

    # Copy main sources (flat, next to build.sbt)
    find "$src_dir" -maxdepth 1 -name '*.scala' -exec cp {} "$project_dir/" \;

    # Copy bundled dependency sources into their own package dirs.
    # Only the dependency's MAIN sources are bundled (the example's own code needs
    # them to compile); its tests are intentionally NOT copied — they belong to the
    # dependency, not to this example, and would otherwise run under the example's
    # `sbt test` (e.g. storage pulling in LinkedListTest).
    local deps
    deps="$(get_bundled_deps "$name")"
    if [[ -n "$deps" ]]; then
        for dep in $deps; do
            local dep_src="$EXAMPLES_ROOT/$dep"
            if [[ -d "$dep_src" ]]; then
                mkdir -p "$project_dir/$dep"
                find "$dep_src" -maxdepth 1 -name '*.scala' -exec cp {} "$project_dir/$dep/" \;
            fi
        done
    fi

    # Copy test sources, with the kept results of the suites of proofs beside them
    if [[ -d "$test_dir" ]]; then
        mkdir -p "$project_dir/test"
        find "$test_dir" -maxdepth 1 \( -name '*.scala' -o -name '*.proofs.json' \) \
            -exec cp {} "$project_dir/test/" \;
        local skipped
        for skipped in $SKIPPED_TESTS; do
            rm -f "$project_dir/test/$skipped"
        done
    fi

    # Rewrite package declarations
    rewrite_packages "$project_dir"

    local has_verification="no"
    if uses_verification "$project_dir/test"; then
        has_verification="yes"
        rewrite_verification_paths "$project_dir/test"
    fi

    # Generate build files
    gen_build_sbt "$out_name" "$src_dir" "$project_dir/test" > "$project_dir/build.sbt"
    gen_plugins_sbt               > "$project_dir/project/plugins.sbt"
    gen_build_properties          > "$project_dir/project/build.properties"
    gen_gitignore                 > "$project_dir/.gitignore"
    gen_getting_started "$out_name" "$has_verification" > "$project_dir/GETTING_STARTED.md"

    # Copy the example's own README if it exists
    if [[ -f "$src_dir/README.md" ]]; then
        cp "$src_dir/README.md" "$project_dir/README.md"
    fi

    echo "  ejected $name -> $project_dir"
}

main() {
    if [[ $# -eq 0 ]]; then usage; exit 1; fi

    # Parse flags in any order; collect positional args.
    local mode=""
    local positional=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)    usage; exit 0 ;;
            --list)       mode="list"; shift ;;
            --all)        mode="all";  shift ;;
            --only)       mode="only"; shift ;;
            --scalus-version)
                if [[ $# -lt 2 ]]; then
                    echo "error: --scalus-version requires a value" >&2; exit 1
                fi
                SCALUS_VERSION="$2"; shift 2 ;;
            --*)
                echo "error: unknown option '$1'" >&2; usage; exit 1 ;;
            *)
                positional+=( "$1" ); shift ;;
        esac
    done

    if [[ -d "$EXAMPLES_ROOT" ]]; then :; else
        echo "error: examples root not found: $EXAMPLES_ROOT" >&2
        exit 1
    fi

    local failures=0
    case "$mode" in
        list)
            while IFS= read -r name; do
                printf "%-25s -> %s\n" "$name" "$(kebab_name "$name")"
            done < <(list_examples) ;;
        all)
            if [[ ${#positional[@]} -ne 1 ]]; then
                echo "error: --all takes exactly one argument: <target-dir>" >&2
                exit 1
            fi
            local target="${positional[0]}"
            mkdir -p "$target"
            echo "ejecting all examples to $target (scalus $SCALUS_VERSION)"
            while IFS= read -r name; do
                eject_one "$name" "$target" || failures=$((failures + 1))
            done < <(list_examples)
            ;;
        only)
            if [[ ${#positional[@]} -lt 2 ]]; then
                echo "error: --only requires at least one example name and a target dir" >&2
                exit 1
            fi
            local target="${positional[${#positional[@]}-1]}"
            local names=( "${positional[@]:0:${#positional[@]}-1}" )
            mkdir -p "$target"
            echo "ejecting ${#names[@]} example(s) to $target (scalus $SCALUS_VERSION)"
            for name in "${names[@]}"; do
                eject_one "$name" "$target" || failures=$((failures + 1))
            done
            ;;
        "")
            usage; exit 1 ;;
    esac

    if [[ $failures -gt 0 ]]; then
        echo "done with $failures failure(s); see messages above" >&2
    fi
}

main "$@"
