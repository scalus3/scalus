use flake

# Load local secrets (e.g. release credentials: PGP_SECRET, PGP_PASSPHRASE,
# SONATYPE_USERNAME, SONATYPE_PASSWORD) from a gitignored .env file if present.
dotenv_if_exists

# Personal, uncommitted overrides for this checkout (.envrc.local is gitignored).
# SBT_OPTS lands after .jvmopts on the java command line, so it wins:
#   export SBT_OPTS="$SBT_OPTS -Xmx16g"
source_env_if_exists .envrc.local
